{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://oreoorbitz.github.io/bais/schema/check-output.json",
	"title": "BaisCheckOutput — bais check --json (SPEC §4.3)",
	"description": "Exit code is 1 when bad is non-empty, any dangling status is Missing, cycles is non-empty, or any close-evidence problem is Missing. External alone never fails.",
	"type": "object",
	"required": ["ok", "bad", "dangling", "cycles"],
	"additionalProperties": false,
	"properties": {
		"ok": { "type": "integer", "minimum": 0, "description": "count of parseable files" },
		"bad": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["file", "error"],
				"additionalProperties": false,
				"properties": {
					"file": { "type": "string" },
					"error": { "type": "string", "description": "message text is unstable (VM traces); match on file" }
				}
			}
		},
		"dangling": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["declaredBy", "from", "to", "kind", "id", "side", "status"],
				"additionalProperties": false,
				"properties": {
					"declaredBy": { "type": "string" },
					"from": { "type": "string" },
					"to": { "type": "string" },
					"kind": { "type": "string" },
					"id": { "type": "string", "description": "the unresolvable end" },
					"side": { "enum": ["from", "to"] },
					"status": { "enum": ["Missing", "External"] }
				}
			}
		},
		"cycles": { "type": "array", "items": { "type": "string" } },
		"evidence": {
			"type": "array",
			"description": "bi#83 close-evidence problems for Done issues (optional; absent in older outputs)",
			"items": {
				"type": "object",
				"required": ["id", "reason", "ref", "kind", "status"],
				"additionalProperties": false,
				"properties": {
					"id": { "type": "string", "description": "Done issue carrying the bad/missing evidence" },
					"reason": { "enum": ["missing-close-evidence", "unresolvable-drill", "unresolvable-verdict"] },
					"ref": { "type": ["string", "null"], "description": "raw ref text, null when nothing was cited" },
					"kind": { "type": ["string", "null"], "enum": ["drill", "verdict", null] },
					"status": { "enum": ["Missing", "External"], "description": "Missing is fatal; External (cross-project verdict) is advisory" }
				}
			}
		}
	}
}
