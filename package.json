{
	"name": "bais",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "BAIS — Basically A made-up Issue Standard (BAML). One Issue = one file in .bais/issues/, git is the hosting.",
	"bin": {
		"bais": "./dist/src/cli.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "node scripts/tiers.mjs t0 t1",
		"test:t0": "node scripts/tiers.mjs t0",
		"test:t1": "node scripts/tiers.mjs t1",
		"test:t2": "node scripts/test-t2.mjs"
	},
	"dependencies": {
		"@boundaryml/baml-bridge": "0.17.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"typescript": "5.9.3"
	}
}
